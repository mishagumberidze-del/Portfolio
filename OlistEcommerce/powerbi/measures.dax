// Canonical definitions mirrored from KPI Measures.tmdl.

Sales / GMV :=
CALCULATE(
SUM('Order Item'[Item Price]),
KEEPFILTERS('Order'[Status] <> "canceled"),
KEEPFILTERS('Order'[Status] <> "unavailable")
)

Orders :=
DISTINCTCOUNT('Order'[Order Key])

Order Status Share % :=
DIVIDE([Orders], CALCULATE([Orders], REMOVEFILTERS('Order'[Status])))

Sales Orders :=
CALCULATE(
[Orders],
KEEPFILTERS('Order'[Status] <> "canceled"),
KEEPFILTERS('Order'[Status] <> "unavailable")
)

Customers :=
DISTINCTCOUNT('Order'[Customer Key])

Average Order Value :=
DIVIDE([Sales / GMV], [Sales Orders])

Units :=
CALCULATE(
COUNTROWS('Order Item'),
KEEPFILTERS('Order'[Status] <> "canceled"),
KEEPFILTERS('Order'[Status] <> "unavailable")
)

Items per Order :=
DIVIDE([Units], [Sales Orders])

Repeat Customers :=
CALCULATE(
DISTINCTCOUNT('Order'[Customer Key]),
KEEPFILTERS('Order'[Purchase Sequence] > 1),
KEEPFILTERS('Order'[Status] <> "canceled"),
KEEPFILTERS('Order'[Status] <> "unavailable")
)

Repeat Customer Rate :=
DIVIDE([Repeat Customers], [Sales Customers])

Customer Purchase Frequency :=
DIVIDE([Sales Orders], [Sales Customers])

GMV per Sales Customer :=
DIVIDE([Sales / GMV], [Sales Customers])

Delivered Orders :=
CALCULATE([Orders], KEEPFILTERS('Order'[Status] = "delivered"))

Cancelled Orders :=
CALCULATE([Orders], KEEPFILTERS('Order'[Status] = "canceled"))

Delivery Rate :=
DIVIDE([Delivered Orders], [Orders])

Cancellation Rate :=
DIVIDE([Cancelled Orders], [Orders])

Average Delivery Days :=
CALCULATE(
AVERAGE('Order'[Delivery Days]),
KEEPFILTERS('Order'[Status] = "delivered")
)

Delivered with Promise :=
CALCULATE(
[Orders],
KEEPFILTERS('Order'[Status] = "delivered"),
KEEPFILTERS('Order'[Delivery Performance] IN {"On Time", "Late"})
)

On-Time Orders :=
CALCULATE(
[Orders],
KEEPFILTERS('Order'[Status] = "delivered"),
KEEPFILTERS('Order'[Delivery Performance] = "On Time")
)

On-Time Delivery % :=
DIVIDE([On-Time Orders], [Delivered with Promise])

Average Delay Days :=
CALCULATE(
AVERAGE('Order'[Delay Days]),
KEEPFILTERS('Order'[Status] = "delivered"),
KEEPFILTERS('Order'[Delivery Performance] = "Late")
)

Freight Cost :=
CALCULATE(
SUM('Order Item'[Freight Value]),
KEEPFILTERS('Order'[Status] <> "canceled"),
KEEPFILTERS('Order'[Status] <> "unavailable")
)

Freight Ratio :=
DIVIDE([Freight Cost], [Sales / GMV])

Average Review Score :=
AVERAGE(Review[Review Score])

Reviewed Orders :=
DISTINCTCOUNT(Review[Order Key])

Average Selling Price :=
DIVIDE([Sales / GMV], [Units])

Product Orders :=
CALCULATE(
DISTINCTCOUNT('Order Item'[Order Key]),
KEEPFILTERS('Order'[Status] <> "canceled"),
KEEPFILTERS('Order'[Status] <> "unavailable")
)

Category Contribution % :=
DIVIDE(
[Sales / GMV],
CALCULATE([Sales / GMV], REMOVEFILTERS(Product[Category]))
)

Active Sellers :=
CALCULATE(
DISTINCTCOUNT('Order Item'[Seller Key]),
KEEPFILTERS('Order'[Status] <> "canceled"),
KEEPFILTERS('Order'[Status] <> "unavailable")
)

Seller Orders :=
CALCULATE(
DISTINCTCOUNT('Order Item'[Order Key]),
KEEPFILTERS('Order'[Status] <> "canceled"),
KEEPFILTERS('Order'[Status] <> "unavailable")
)

Seller Average Order Value :=
DIVIDE([Sales / GMV], [Seller Orders])

Customers in Item Context :=
VAR _visibleOrders = VALUES('Order Item'[Order Key])
RETURN
CALCULATE(
DISTINCTCOUNT('Order'[Customer Key]),
TREATAS(_visibleOrders, 'Order'[Order Key]),
KEEPFILTERS('Order'[Status] <> "canceled"),
KEEPFILTERS('Order'[Status] <> "unavailable")
)

Average Review Score in Item Context :=
VAR _visibleOrders = VALUES('Order Item'[Order Key])
RETURN
CALCULATE(
[Average Review Score],
TREATAS(_visibleOrders, Review[Order Key]),
KEEPFILTERS('Order'[Status] <> "canceled"),
KEEPFILTERS('Order'[Status] <> "unavailable")
)

On-Time Delivery % in Item Context :=
VAR _visibleOrders = VALUES('Order Item'[Order Key])
RETURN
CALCULATE(
[On-Time Delivery %],
TREATAS(_visibleOrders, 'Order'[Order Key])
)

Average Delivery Days in Item Context :=
VAR _visibleOrders = VALUES('Order Item'[Order Key])
RETURN
CALCULATE(
[Average Delivery Days],
TREATAS(_visibleOrders, 'Order'[Order Key])
)

Average Delivery Days in Review Context :=
VAR _visibleOrders = VALUES(Review[Order Key])
RETURN
CALCULATE(
[Average Delivery Days],
TREATAS(_visibleOrders, 'Order'[Order Key])
)

Average Delay Days in Review Context :=
VAR _visibleOrders = VALUES(Review[Order Key])
RETURN
CALCULATE(
[Average Delay Days],
TREATAS(_visibleOrders, 'Order'[Order Key])
)

On-Time Delivery % in Review Context :=
VAR _visibleOrders = VALUES(Review[Order Key])
RETURN
CALCULATE(
[On-Time Delivery %],
TREATAS(_visibleOrders, 'Order'[Order Key])
)

Selected Top N :=
SELECTEDVALUE('Top N'[Value], 10)

Seller in Top N :=
VAR TopSellers = TOPN([Selected Top N], ALLSELECTED(Seller), [Sales / GMV], DESC, Seller[Seller Key], ASC)
RETURN IF(NOT ISBLANK([Sales / GMV]) && CONTAINS(TopSellers, Seller[Seller Key], SELECTEDVALUE(Seller[Seller Key])), 1, 0)

Seller Top N Sales :=
IF([Seller in Top N] = 1, [Sales / GMV])

Selected Metric :=
SWITCH(
SELECTEDVALUE('Metric Selector'[Metric], "Sales / GMV"),
"Sales / GMV", [Sales / GMV],
"Orders", [Orders],
"Customers", [Customers],
"Average Order Value", [Average Order Value],
"Units", [Units],
[Sales / GMV]
)

Active Cohort Customers :=
VAR _cohort = SELECTEDVALUE('Cohort Retention'[Cohort Month])
VAR _activity = SELECTEDVALUE('Cohort Retention'[Activity Month])
RETURN IF(NOT ISBLANK(_cohort) && NOT ISBLANK(_activity),
COALESCE(CALCULATE([Sales Customers], REMOVEFILTERS('Date'),
KEEPFILTERS(TREATAS({_cohort}, 'Order'[Cohort Month])),
TREATAS({YEAR(_activity) * 100 + MONTH(_activity)}, 'Date'[Year Month Sort])), 0))

Cohort Customers :=
VAR _cohort = SELECTEDVALUE('Cohort Retention'[Cohort Month])
RETURN IF(NOT ISBLANK(_cohort),
CALCULATE([Sales Customers], REMOVEFILTERS('Date'),
KEEPFILTERS(TREATAS({_cohort}, 'Order'[Cohort Month]))))

Retention Rate :=
IF(
ISINSCOPE('Cohort Retention'[Cohort Month]) &&
ISINSCOPE('Cohort Retention'[Months Since First Purchase]),
DIVIDE([Active Cohort Customers], [Cohort Customers])
)

Sales Customers :=
CALCULATE([Customers], KEEPFILTERS('Order'[Status] <> "canceled"), KEEPFILTERS('Order'[Status] <> "unavailable"))

Reviews :=
COUNTROWS(Review)
