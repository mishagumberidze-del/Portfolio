/// Dedicated measure table. Business logic is centralized here and documented per KPI.
table 'KPI Measures'

	/// Merchandise sales for all orders except canceled and unavailable orders; freight is excluded.
	measure 'Sales / GMV' = ```
			CALCULATE(
				SUM('Order Item'[Item Price]),
				KEEPFILTERS('Order'[Status] <> "canceled"),
				KEEPFILTERS('Order'[Status] <> "unavailable")
			)
			```
		formatString: "R$ #,##0.00;(-R$ #,##0.00);R$ 0.00"
		displayFolder: Commercial

	/// Distinct orders in the current filter context, regardless of status.
	measure Orders = DISTINCTCOUNT('Order'[Order Key])
		formatString: #,##0
		displayFolder: Commercial

	/// Share of orders for the visible status against all statuses in the active non-status filter context.
	measure 'Order Status Share %' = DIVIDE([Orders], CALCULATE([Orders], REMOVEFILTERS('Order'[Status])))
		formatString: 0.00%
		displayFolder: Commercial

	/// Distinct orders excluding canceled and unavailable statuses.
	measure 'Sales Orders' = ```
			CALCULATE(
				[Orders],
				KEEPFILTERS('Order'[Status] <> "canceled"),
				KEEPFILTERS('Order'[Status] <> "unavailable")
			)
			```
		formatString: #,##0
		displayFolder: Commercial

	/// Distinct customer_unique_id values represented by orders in context.
	measure Customers = DISTINCTCOUNT('Order'[Customer Key])
		formatString: #,##0
		displayFolder: Customer

	/// Merchandise sales divided by non-canceled, non-unavailable orders.
	measure 'Average Order Value' = DIVIDE([Sales / GMV], [Sales Orders])
		formatString: "R$ #,##0.00"
		displayFolder: Commercial

	/// Order-item rows on commercial orders; one row represents one sold item occurrence.
	measure Units = ```
			CALCULATE(
				COUNTROWS('Order Item'),
				KEEPFILTERS('Order'[Status] <> "canceled"),
				KEEPFILTERS('Order'[Status] <> "unavailable")
			)
			```
		formatString: #,##0
		displayFolder: Commercial

	/// Units divided by sales orders.
	measure 'Items per Order' = DIVIDE([Units], [Sales Orders])
		formatString: 0.00
		displayFolder: Commercial

	/// Customers with a second or later commercial purchase in the visible period.
	measure 'Repeat Customers' = ```
			CALCULATE(
				DISTINCTCOUNT('Order'[Customer Key]),
				KEEPFILTERS('Order'[Purchase Sequence] > 1),
				KEEPFILTERS('Order'[Status] <> "canceled"),
				KEEPFILTERS('Order'[Status] <> "unavailable")
			)
			```
		formatString: #,##0
		displayFolder: Customer

	/// Repeat commercial purchasers divided by commercial purchasers in the current context.
	measure 'Repeat Customer Rate' = DIVIDE([Repeat Customers], [Sales Customers])
		formatString: 0.00%
		displayFolder: Customer

	/// Commercial orders divided by distinct commercial purchasers.
	measure 'Customer Purchase Frequency' = DIVIDE([Sales Orders], [Sales Customers])
		formatString: 0.00
		displayFolder: Customer

	/// Commercial merchandise GMV divided by distinct commercial purchasers.
	measure 'GMV per Sales Customer' = DIVIDE([Sales / GMV], [Sales Customers])
		formatString: "R$ #,##0.00"
		displayFolder: Customer

	/// Distinct delivered orders.
	measure 'Delivered Orders' = CALCULATE([Orders], KEEPFILTERS('Order'[Status] = "delivered"))
		formatString: #,##0
		displayFolder: Fulfilment

	/// Distinct canceled orders.
	measure 'Cancelled Orders' = CALCULATE([Orders], KEEPFILTERS('Order'[Status] = "canceled"))
		formatString: #,##0
		displayFolder: Fulfilment

	/// Delivered orders divided by all orders.
	measure 'Delivery Rate' = DIVIDE([Delivered Orders], [Orders])
		formatString: 0.00%
		displayFolder: Fulfilment

	/// Canceled orders divided by all orders.
	measure 'Cancellation Rate' = DIVIDE([Cancelled Orders], [Orders])
		formatString: 0.00%
		displayFolder: Fulfilment

	/// Average elapsed calendar days from purchase to customer delivery for delivered orders.
	measure 'Average Delivery Days' = ```
			CALCULATE(
				AVERAGE('Order'[Delivery Days]),
				KEEPFILTERS('Order'[Status] = "delivered")
			)
			```
		formatString: 0.0
		displayFolder: Fulfilment

	/// Delivered orders with an evaluable promised-versus-actual delivery outcome.
	measure 'Delivered with Promise' = ```
			CALCULATE(
				[Orders],
				KEEPFILTERS('Order'[Status] = "delivered"),
				KEEPFILTERS('Order'[Delivery Performance] IN {"On Time", "Late"})
			)
			```
		formatString: #,##0
		displayFolder: Fulfilment

	/// Delivered orders received on or before the promised date.
	measure 'On-Time Orders' = ```
			CALCULATE(
				[Orders],
				KEEPFILTERS('Order'[Status] = "delivered"),
				KEEPFILTERS('Order'[Delivery Performance] = "On Time")
			)
			```
		formatString: #,##0
		displayFolder: Fulfilment

	/// On-time orders divided by delivered orders with a comparable promise date.
	measure 'On-Time Delivery %' = DIVIDE([On-Time Orders], [Delivered with Promise])
		formatString: 0.00%
		displayFolder: Fulfilment

	/// Average positive actual-minus-promised days among late deliveries only.
	measure 'Average Delay Days' = ```
			CALCULATE(
				AVERAGE('Order'[Delay Days]),
				KEEPFILTERS('Order'[Status] = "delivered"),
				KEEPFILTERS('Order'[Delivery Performance] = "Late")
			)
			```
		formatString: 0.0
		displayFolder: Fulfilment

	/// Sum of order-item freight for commercial orders.
	measure 'Freight Cost' = ```
			CALCULATE(
				SUM('Order Item'[Freight Value]),
				KEEPFILTERS('Order'[Status] <> "canceled"),
				KEEPFILTERS('Order'[Status] <> "unavailable")
			)
			```
		formatString: "R$ #,##0.00"
		displayFolder: Fulfilment

	/// Freight cost divided by merchandise sales.
	measure 'Freight Ratio' = DIVIDE([Freight Cost], [Sales / GMV])
		formatString: 0.00%
		displayFolder: Fulfilment

	/// Arithmetic mean of available review scores.
	measure 'Average Review Score' = AVERAGE(Review[Review Score])
		formatString: 0.00
		displayFolder: Experience

	/// Distinct orders with a retained review.
	measure 'Reviewed Orders' = DISTINCTCOUNT(Review[Order Key])
		formatString: #,##0
		displayFolder: Experience

	/// Merchandise sales divided by units.
	measure 'Average Selling Price' = DIVIDE([Sales / GMV], [Units])
		formatString: "R$ #,##0.00"
		displayFolder: Product

	/// Distinct commercial orders represented by the visible order-item rows.
	measure 'Product Orders' = ```
			CALCULATE(
				DISTINCTCOUNT('Order Item'[Order Key]),
				KEEPFILTERS('Order'[Status] <> "canceled"),
				KEEPFILTERS('Order'[Status] <> "unavailable")
			)
			```
		formatString: #,##0
		displayFolder: Product

	/// Category sales divided by sales with the category filter removed.
	measure 'Category Contribution %' = ```
			DIVIDE(
				[Sales / GMV],
				CALCULATE([Sales / GMV], REMOVEFILTERS(Product[Category]))
			)
			```
		formatString: 0.00%
		displayFolder: Product

	/// Distinct sellers represented by commercial order-item rows.
	measure 'Active Sellers' = ```
			CALCULATE(
				DISTINCTCOUNT('Order Item'[Seller Key]),
				KEEPFILTERS('Order'[Status] <> "canceled"),
				KEEPFILTERS('Order'[Status] <> "unavailable")
			)
			```
		formatString: #,##0
		displayFolder: Seller

	/// Distinct commercial orders represented by the visible seller order-item rows.
	measure 'Seller Orders' = ```
			CALCULATE(
				DISTINCTCOUNT('Order Item'[Order Key]),
				KEEPFILTERS('Order'[Status] <> "canceled"),
				KEEPFILTERS('Order'[Status] <> "unavailable")
			)
			```
		formatString: #,##0
		displayFolder: Seller

	/// Sales divided by distinct seller orders in the current seller/item context.
	measure 'Seller Average Order Value' = DIVIDE([Sales / GMV], [Seller Orders])
		formatString: "R$ #,##0.00"
		displayFolder: Seller

	/// Distinct customers associated with visible order-item rows via order key.
	measure 'Customers in Item Context' = ```
			VAR _visibleOrders = VALUES('Order Item'[Order Key])
			RETURN
				CALCULATE(
					DISTINCTCOUNT('Order'[Customer Key]),
					TREATAS(_visibleOrders, 'Order'[Order Key]),
					KEEPFILTERS('Order'[Status] <> "canceled"),
					KEEPFILTERS('Order'[Status] <> "unavailable")
				)
			```
		formatString: #,##0
		displayFolder: Context Bridges

	/// Average review score for orders associated with visible order-item rows.
	measure 'Average Review Score in Item Context' = ```
			VAR _visibleOrders = VALUES('Order Item'[Order Key])
			RETURN
				CALCULATE(
					[Average Review Score],
					TREATAS(_visibleOrders, Review[Order Key]),
					KEEPFILTERS('Order'[Status] <> "canceled"),
					KEEPFILTERS('Order'[Status] <> "unavailable")
				)
			```
		formatString: 0.00
		displayFolder: Context Bridges

	/// On-time rate for orders associated with visible order-item rows.
	measure 'On-Time Delivery % in Item Context' = ```
			VAR _visibleOrders = VALUES('Order Item'[Order Key])
			RETURN
				CALCULATE(
					[On-Time Delivery %],
					TREATAS(_visibleOrders, 'Order'[Order Key])
				)
			```
		formatString: 0.00%
		displayFolder: Context Bridges

	/// Average delivery duration for orders associated with visible order-item rows.
	measure 'Average Delivery Days in Item Context' = ```
			VAR _visibleOrders = VALUES('Order Item'[Order Key])
			RETURN
				CALCULATE(
					[Average Delivery Days],
					TREATAS(_visibleOrders, 'Order'[Order Key])
				)
			```
		formatString: 0.0
		displayFolder: Context Bridges

	/// Average delivery duration for orders associated with the visible review rows.
	measure 'Average Delivery Days in Review Context' = ```
			VAR _visibleOrders = VALUES(Review[Order Key])
			RETURN
				CALCULATE(
					[Average Delivery Days],
					TREATAS(_visibleOrders, 'Order'[Order Key])
				)
			```
		formatString: 0.0
		displayFolder: Context Bridges

	/// Average delivery delay for orders associated with the visible review rows.
	measure 'Average Delay Days in Review Context' = ```
			VAR _visibleOrders = VALUES(Review[Order Key])
			RETURN
				CALCULATE(
					[Average Delay Days],
					TREATAS(_visibleOrders, 'Order'[Order Key])
				)
			```
		formatString: 0.0
		displayFolder: Context Bridges

	/// On-time delivery rate for orders associated with the visible review rows.
	measure 'On-Time Delivery % in Review Context' = ```
			VAR _visibleOrders = VALUES(Review[Order Key])
			RETURN
				CALCULATE(
					[On-Time Delivery %],
					TREATAS(_visibleOrders, 'Order'[Order Key])
				)
			```
		formatString: 0.00%
		displayFolder: Context Bridges

	/// Selected Top-N threshold, defaulting to 10.
	measure 'Selected Top N' = SELECTEDVALUE('Top N'[Value], 10)
		formatString: 0
		displayFolder: Ranking

	/// Visual filter flag for sellers inside the selected Top-N.
	measure 'Seller in Top N' = ```
			VAR TopSellers = TOPN([Selected Top N], ALLSELECTED(Seller), [Sales / GMV], DESC, Seller[Seller Key], ASC)
			RETURN IF(NOT ISBLANK([Sales / GMV]) && CONTAINS(TopSellers, Seller[Seller Key], SELECTEDVALUE(Seller[Seller Key])), 1, 0)
			```
		formatString: 0
		displayFolder: Ranking

	/// Sales displayed only for sellers inside the selected Top-N threshold.
	measure 'Seller Top N Sales' = IF([Seller in Top N] = 1, [Sales / GMV])
		formatString: "R$ #,##0.00"
		displayFolder: Ranking

	/// Metric value chosen from the disconnected metric selector.
	measure 'Selected Metric' = ```
			SWITCH(
				SELECTEDVALUE('Metric Selector'[Metric], "Sales / GMV"),
				"Sales / GMV", [Sales / GMV],
				"Orders", [Orders],
				"Customers", [Customers],
				"Average Order Value", [Average Order Value],
				"Units", [Units],
				[Sales / GMV]
			)
			```
		formatString: #,##0.00
		displayFolder: Dynamic Metric

	/// Active commercial purchasers in the selected cohort/activity cell, preserving customer filters.
	measure 'Active Cohort Customers' = ```
			VAR _cohort = SELECTEDVALUE('Cohort Retention'[Cohort Month])
			VAR _activity = SELECTEDVALUE('Cohort Retention'[Activity Month])
			RETURN IF(NOT ISBLANK(_cohort) && NOT ISBLANK(_activity),
				COALESCE(CALCULATE([Sales Customers], REMOVEFILTERS('Date'),
					KEEPFILTERS(TREATAS({_cohort}, 'Order'[Cohort Month])),
					TREATAS({YEAR(_activity) * 100 + MONTH(_activity)}, 'Date'[Year Month Sort])), 0))
			```
		formatString: #,##0
		displayFolder: Cohort

	/// Original commercial cohort population after customer filters, independent of the activity month.
	measure 'Cohort Customers' = ```
			VAR _cohort = SELECTEDVALUE('Cohort Retention'[Cohort Month])
			RETURN IF(NOT ISBLANK(_cohort),
				CALCULATE([Sales Customers], REMOVEFILTERS('Date'),
					KEEPFILTERS(TREATAS({_cohort}, 'Order'[Cohort Month]))))
			```
		formatString: #,##0
		displayFolder: Cohort

	/// Active customers divided by original cohort size at an individual cohort-period cell; totals are intentionally blank.
	measure 'Retention Rate' = ```
			IF(
				ISINSCOPE('Cohort Retention'[Cohort Month]) &&
				ISINSCOPE('Cohort Retention'[Months Since First Purchase]),
				DIVIDE([Active Cohort Customers], [Cohort Customers])
			)
			```
		formatString: 0.00%
		displayFolder: Cohort

	/// Customers with at least one non-canceled, non-unavailable purchase in context.
	measure 'Sales Customers' = CALCULATE([Customers], KEEPFILTERS('Order'[Status] <> "canceled"), KEEPFILTERS('Order'[Status] <> "unavailable"))
		formatString: #,##0
		displayFolder: Customer

	/// Retained review records; one order may have several reviews. Score-group shares use this additive count.
	measure Reviews = COUNTROWS(Review)
		formatString: #,##0
		displayFolder: Experience

	column Value
		isHidden
		sourceColumn: [Value]

	partition 'KPI Measures' = calculated
		mode: import
		source = ROW("Value", BLANK())
