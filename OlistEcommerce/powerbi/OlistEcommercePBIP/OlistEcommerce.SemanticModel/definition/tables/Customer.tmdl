/// One row per customer_unique_id. Purchase history excludes canceled/unavailable orders; completed metrics use delivered orders.
table Customer

	column 'Customer Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: CustomerKey

	column 'Customer Unique ID'
		dataType: string
		isHidden
		sourceColumn: CustomerUniqueId

	/// Short presentation label; the full source identifier remains preserved in Customer Unique ID.
	column 'Customer Display ID'
		dataType: string
		sourceColumn: CustomerDisplayId

	column 'Home Geography Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: HomeGeographyKey

	column City
		dataType: string
		dataCategory: City
		sourceColumn: City

	column State
		dataType: string
		dataCategory: StateOrProvince
		sourceColumn: StateCode

	column 'First Purchase'
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: FirstPurchaseDateTime

	column 'Last Purchase'
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: LastPurchaseDateTime

	column 'Cohort Month'
		dataType: dateTime
		formatString: MMM yyyy
		summarizeBy: none
		sourceColumn: CohortMonth

	column 'Purchase Count'
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: PurchaseCount

	column 'Avg Days Between Purchases'
		dataType: decimal
		formatString: 0.0
		summarizeBy: none
		sourceColumn: AverageDaysBetweenPurchases

	column 'Customer Type'
		dataType: string
		sourceColumn: CustomerType

	column 'Recency Days'
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: RecencyDays

	column 'Completed Purchase Count'
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: CompletedPurchaseCount

	column 'Customer Sales'
		dataType: decimal
		formatString: "R$ #,##0.00"
		summarizeBy: sum
		sourceColumn: CustomerSales

	column 'Customer Freight'
		dataType: decimal
		formatString: "R$ #,##0.00"
		summarizeBy: sum
		sourceColumn: CustomerFreight

	column 'Avg Delivery Days'
		dataType: decimal
		formatString: 0.0
		summarizeBy: none
		sourceColumn: AverageDeliveryDays

	column 'On-Time Rate'
		dataType: decimal
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: OnTimeRate

	column 'Avg Review Score'
		dataType: decimal
		formatString: 0.00
		summarizeBy: none
		sourceColumn: AverageReviewScore

	column 'Completed Purchase Group'
		dataType: string
		sourceColumn: CompletedPurchaseGroup

	partition Customer = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(#"DataRoot" & "\customer.tsv"), [Delimiter="#(tab)", Columns=19, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				Named = Table.RenameColumns(Source, {{"Column1","CustomerKey"},{"Column2","CustomerUniqueId"},{"Column3","HomeGeographyKey"},{"Column4","City"},{"Column5","StateCode"},{"Column6","FirstPurchaseDateTime"},{"Column7","LastPurchaseDateTime"},{"Column8","CohortMonth"},{"Column9","PurchaseCount"},{"Column10","AverageDaysBetweenPurchases"},{"Column11","CustomerType"},{"Column12","RecencyDays"},{"Column13","CompletedPurchaseCount"},{"Column14","CustomerSales"},{"Column15","CustomerFreight"},{"Column16","AverageDeliveryDays"},{"Column17","OnTimeRate"},{"Column18","AverageReviewScore"},{"Column19","CompletedPurchaseGroup"}}),
				Typed = Table.TransformColumnTypes(Named, {{"CustomerKey", Int64.Type},{"CustomerUniqueId", type text},{"HomeGeographyKey", Int64.Type},{"City", type text},{"StateCode", type text},{"FirstPurchaseDateTime", type datetime},{"LastPurchaseDateTime", type datetime},{"CohortMonth", type date},{"PurchaseCount", Int64.Type},{"AverageDaysBetweenPurchases", type number},{"CustomerType", type text},{"RecencyDays", Int64.Type},{"CompletedPurchaseCount", Int64.Type},{"CustomerSales", Currency.Type},{"CustomerFreight", Currency.Type},{"AverageDeliveryDays", type number},{"OnTimeRate", type number},{"AverageReviewScore", type number},{"CompletedPurchaseGroup", type text}}, "en-US"),
				Customer360 = Table.AddColumn(Typed, "CustomerDisplayId", each Text.Start([CustomerUniqueId], 12) & "…", type text)
			in
				Customer360
