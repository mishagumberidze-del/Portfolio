/// One row per customer_unique_id. Olist order-specific customer_id remains on Order.
table Customer

	column 'Customer Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: CustomerKey

	column 'Customer Unique ID'
		dataType: string
		isHidden
		sourceColumn: CustomerUniqueId

	/// Short presentation label; the full source identifier remains preserved in Customer Unique ID.
	column 'Customer Display ID'
		dataType: string
		sourceColumn: CustomerDisplayId

	column 'Home Geography Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: HomeGeographyKey

	column City
		dataType: string
		dataCategory: City
		sourceColumn: City

	column State
		dataType: string
		dataCategory: StateOrProvince
		sourceColumn: StateCode

	column 'First Purchase'
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: FirstPurchaseDateTime

	column 'Last Purchase'
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: LastPurchaseDateTime

	column 'Cohort Month'
		dataType: dateTime
		formatString: MMM yyyy
		summarizeBy: none
		sourceColumn: CohortMonth

	column 'Purchase Count'
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: PurchaseCount

	column 'Purchase Frequency'
		dataType: decimal
		formatString: 0.00
		summarizeBy: average
		sourceColumn: CustomerPurchaseFrequency

	column 'Avg Days Between Purchases'
		dataType: decimal
		formatString: 0.0
		summarizeBy: average
		sourceColumn: AverageDaysBetweenPurchases

	column 'Customer Type'
		dataType: string
		sourceColumn: CustomerType

	column 'Recency Days'
		dataType: int64
		formatString: #,##0
		summarizeBy: average
		sourceColumn: RecencyDays

	column 'Completed Purchase Count'
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: CompletedPurchaseCount

	column 'Customer Sales'
		dataType: decimal
		formatString: "R$ #,##0.00"
		summarizeBy: sum
		sourceColumn: CustomerSales

	column 'Customer Freight'
		dataType: decimal
		formatString: "R$ #,##0.00"
		summarizeBy: sum
		sourceColumn: CustomerFreight

	column 'Avg Delivery Days'
		dataType: decimal
		formatString: 0.0
		summarizeBy: average
		sourceColumn: AverageDeliveryDays

	column 'On-Time Rate'
		dataType: decimal
		formatString: 0.0%
		summarizeBy: average
		sourceColumn: OnTimeRate

	column 'Avg Review Score'
		dataType: decimal
		formatString: 0.00
		summarizeBy: average
		sourceColumn: AverageReviewScore

	column 'R Score'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: RScore

	column 'F Score'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: FScore

	column 'M Score'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: MScore

	column 'RFM Segment'
		dataType: string
		sourceColumn: RfmSegment

	partition Customer = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(#"DataRoot" & "\customer.tsv"), [Delimiter="#(tab)", Columns=23, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				Named = Table.RenameColumns(Source, {{"Column1","CustomerKey"},{"Column2","CustomerUniqueId"},{"Column3","HomeGeographyKey"},{"Column4","City"},{"Column5","StateCode"},{"Column6","FirstPurchaseDateTime"},{"Column7","LastPurchaseDateTime"},{"Column8","CohortMonth"},{"Column9","PurchaseCount"},{"Column10","CustomerPurchaseFrequency"},{"Column11","AverageDaysBetweenPurchases"},{"Column12","CustomerType"},{"Column13","RecencyDays"},{"Column14","CompletedPurchaseCount"},{"Column15","CustomerSales"},{"Column16","CustomerFreight"},{"Column17","AverageDeliveryDays"},{"Column18","OnTimeRate"},{"Column19","AverageReviewScore"},{"Column20","RScore"},{"Column21","FScore"},{"Column22","MScore"},{"Column23","RfmSegment"}}),
				Typed = Table.TransformColumnTypes(Named, {{"CustomerKey", Int64.Type},{"CustomerUniqueId", type text},{"HomeGeographyKey", Int64.Type},{"City", type text},{"StateCode", type text},{"FirstPurchaseDateTime", type datetime},{"LastPurchaseDateTime", type datetime},{"CohortMonth", type date},{"PurchaseCount", Int64.Type},{"CustomerPurchaseFrequency", type number},{"AverageDaysBetweenPurchases", type number},{"CustomerType", type text},{"RecencyDays", Int64.Type},{"CompletedPurchaseCount", Int64.Type},{"CustomerSales", Currency.Type},{"CustomerFreight", Currency.Type},{"AverageDeliveryDays", type number},{"OnTimeRate", type number},{"AverageReviewScore", type number},{"RScore", Int64.Type},{"FScore", Int64.Type},{"MScore", Int64.Type},{"RfmSegment", type text}}, "en-US"),
				Customer360 = Table.AddColumn(Typed, "CustomerDisplayId", each Text.Start([CustomerUniqueId], 12) & "…", type text)
			in
				Customer360
