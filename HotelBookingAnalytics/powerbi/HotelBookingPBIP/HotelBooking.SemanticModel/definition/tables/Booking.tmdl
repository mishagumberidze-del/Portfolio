table Booking
	column BookingId
		dataType: int64
		summarizeBy: none
		sourceColumn: BookingId
		isHidden

	column ArrivalDateKey
		dataType: int64
		summarizeBy: none
		sourceColumn: ArrivalDateKey
		isHidden

	column HotelName
		dataType: string
		summarizeBy: none
		sourceColumn: HotelName

	column SegmentName
		dataType: string
		summarizeBy: none
		sourceColumn: SegmentName

	column CustomerType
		dataType: string
		summarizeBy: none
		sourceColumn: CustomerType

	column DistributionChannel
		dataType: string
		summarizeBy: none
		sourceColumn: DistributionChannel

	column IsCanceled
		dataType: int64
		summarizeBy: none
		sourceColumn: IsCanceled

	column LeadTime
		dataType: int64
		summarizeBy: none
		sourceColumn: LeadTime

	column StayNights
		dataType: int64
		summarizeBy: none
		sourceColumn: StayNights

	column ADR
		dataType: decimal
		summarizeBy: none
		sourceColumn: ADR

	column RealizedRoomValue
		dataType: decimal
		summarizeBy: none
		sourceColumn: RealizedRoomValue

	column GrossRoomValue
		dataType: decimal
		summarizeBy: none
		sourceColumn: GrossRoomValue

	column RoomChanged
		dataType: int64
		summarizeBy: none
		sourceColumn: RoomChanged

	column CountryCode
		dataType: string
		summarizeBy: none
		sourceColumn: CountryCode

	column IsRepeatedGuest
		dataType: int64
		summarizeBy: none
		sourceColumn: IsRepeatedGuest

	column DepositType
		dataType: string
		summarizeBy: none
		sourceColumn: DepositType

	column ReservationStatus
		dataType: string
		summarizeBy: none
		sourceColumn: ReservationStatus

	column DataQualityFlag
		dataType: int64
		summarizeBy: none
		sourceColumn: DataQualityFlag

	column BookingChanges
		dataType: int64
		summarizeBy: none
		sourceColumn: BookingChanges

	column SpecialRequests
		dataType: int64
		summarizeBy: none
		sourceColumn: SpecialRequests

	column LeadTimeBand
		dataType: string
		summarizeBy: none
		sourceColumn: LeadTimeBand
		sortByColumn: LeadTimeBandSort

	column StayBand
		dataType: string
		summarizeBy: none
		sourceColumn: StayBand
		sortByColumn: StayBandSort

	column ReservedRoomType
		dataType: string
		summarizeBy: none
		sourceColumn: ReservedRoomType

	column AssignedRoomType
		dataType: string
		summarizeBy: none
		sourceColumn: AssignedRoomType

	column LeadTimeBandSort = SWITCH(TRUE(), Booking[LeadTime] < 30, 1, Booking[LeadTime] < 90, 2, Booking[LeadTime] < 180, 3, 4)
		dataType: int64
		isHidden
		summarizeBy: none

	column StayBandSort = SWITCH(TRUE(), Booking[StayNights] = 0, 0, Booking[StayNights] <= 3, 1, Booking[StayNights] <= 7, 2, 3)
		dataType: int64
		isHidden
		summarizeBy: none

	partition Booking = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(#"DataRoot" & "\booking.tsv"), [Delimiter="#(tab)", Columns=24, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				Named = Table.RenameColumns(Source, {{"Column1","BookingId"},{"Column2","ArrivalDateKey"},{"Column3","HotelName"},{"Column4","SegmentName"},{"Column5","CustomerType"},{"Column6","DistributionChannel"},{"Column7","IsCanceled"},{"Column8","LeadTime"},{"Column9","StayNights"},{"Column10","ADR"},{"Column11","RealizedRoomValue"},{"Column12","GrossRoomValue"},{"Column13","RoomChanged"},{"Column14","CountryCode"},{"Column15","IsRepeatedGuest"},{"Column16","DepositType"},{"Column17","ReservationStatus"},{"Column18","DataQualityFlag"},{"Column19","BookingChanges"},{"Column20","SpecialRequests"},{"Column21","LeadTimeBand"},{"Column22","StayBand"},{"Column23","ReservedRoomType"},{"Column24","AssignedRoomType"}}),
				Typed = Table.TransformColumnTypes(Named, {{"BookingId", Int64.Type},{"ArrivalDateKey", Int64.Type},{"HotelName", type text},{"SegmentName", type text},{"CustomerType", type text},{"DistributionChannel", type text},{"IsCanceled", Int64.Type},{"LeadTime", Int64.Type},{"StayNights", Int64.Type},{"ADR", type number},{"RealizedRoomValue", type number},{"GrossRoomValue", type number},{"RoomChanged", Int64.Type},{"CountryCode", type text},{"IsRepeatedGuest", Int64.Type},{"DepositType", type text},{"ReservationStatus", type text},{"DataQualityFlag", Int64.Type},{"BookingChanges", Int64.Type},{"SpecialRequests", Int64.Type},{"LeadTimeBand", type text},{"StayBand", type text},{"ReservedRoomType", type text},{"AssignedRoomType", type text}}, "en-US")
			in
				Typed
