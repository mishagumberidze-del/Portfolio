table Date
	column DateKey
		dataType: int64
		summarizeBy: none
		sourceColumn: DateKey
		isHidden

	column CalendarDate
		dataType: dateTime
		summarizeBy: none
		sourceColumn: CalendarDate

	column CalendarYear
		dataType: int64
		summarizeBy: none
		sourceColumn: CalendarYear

	column CalendarMonth
		dataType: int64
		summarizeBy: none
		sourceColumn: CalendarMonth

	column MonthName
		dataType: string
		summarizeBy: none
		sourceColumn: MonthName

	column QuarterNumber
		dataType: int64
		summarizeBy: none
		sourceColumn: QuarterNumber

	column YearMonth
		dataType: string
		summarizeBy: none
		sourceColumn: YearMonth
		sortByColumn: YearMonthSort

	column YearMonthSort
		dataType: int64
		summarizeBy: none
		sourceColumn: YearMonthSort
		isHidden

	partition Date = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(#"DataRoot" & "\date.tsv"), [Delimiter="#(tab)", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				Named = Table.RenameColumns(Source, {{"Column1","DateKey"},{"Column2","CalendarDate"},{"Column3","CalendarYear"},{"Column4","CalendarMonth"},{"Column5","MonthName"},{"Column6","QuarterNumber"},{"Column7","YearMonth"},{"Column8","YearMonthSort"}}),
				Typed = Table.TransformColumnTypes(Named, {{"DateKey", Int64.Type},{"CalendarDate", type date},{"CalendarYear", Int64.Type},{"CalendarMonth", Int64.Type},{"MonthName", type text},{"QuarterNumber", Int64.Type},{"YearMonth", type text},{"YearMonthSort", Int64.Type}}, "en-US")
			in
				Typed
