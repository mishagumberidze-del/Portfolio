table 'KPI Measures'

	measure 'Bookings' = COUNTROWS(Booking)
		formatString: #,##0

	measure 'Cancellations' = CALCULATE([Bookings], KEEPFILTERS(Booking[IsCanceled] = 1))
		formatString: #,##0

	measure 'Cancellation Rate' = DIVIDE([Cancellations], [Bookings])
		formatString: 0.0%

	measure 'Room Value Proxy' = CALCULATE(SUM(Booking[RealizedRoomValue]), KEEPFILTERS(Booking[IsCanceled] = 0), KEEPFILTERS(Booking[StayNights] > 0), KEEPFILTERS(Booking[ADR] >= 0))
		formatString: #,##0.00

	measure 'Stay-weighted ADR' = DIVIDE([Room Value Proxy], CALCULATE(SUM(Booking[StayNights]), KEEPFILTERS(Booking[IsCanceled] = 0), KEEPFILTERS(Booking[StayNights] > 0), KEEPFILTERS(Booking[ADR] >= 0)))
		formatString: #,##0.00

	measure 'Average Lead Time' = AVERAGE(Booking[LeadTime])
		formatString: #,##0.0

	measure 'Stayed Bookings' = CALCULATE([Bookings], KEEPFILTERS(Booking[IsCanceled] = 0), KEEPFILTERS(Booking[StayNights] > 0))
		formatString: #,##0

	measure 'Stay Nights' = CALCULATE(SUM(Booking[StayNights]), KEEPFILTERS(Booking[IsCanceled] = 0), KEEPFILTERS(Booking[StayNights] > 0))
		formatString: #,##0

	measure 'Average Stay Nights' = CALCULATE(AVERAGE(Booking[StayNights]), KEEPFILTERS(Booking[IsCanceled] = 0), KEEPFILTERS(Booking[StayNights] > 0))
		formatString: #,##0.0

	measure 'Room Assignment Difference' = DIVIDE(CALCULATE([Stayed Bookings], KEEPFILTERS(Booking[RoomChanged] = 1)), [Stayed Bookings])
		formatString: 0.0%

	column Value
		isHidden
		sourceColumn: [Value]

	partition 'KPI Measures' = calculated
		mode: import
		source = ROW("Value", BLANK())
